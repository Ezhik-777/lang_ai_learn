# Postgres (в Coolify внутренний hostname контейнера, локально — из docker-compose)
DATABASE_URL=postgres://lang:lang@localhost:5432/langailearn

# Clerk (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# OpenAI (для теста уровня и проверки предложений)
OPENAI_API_KEY=

# Azure Speech Service (для Pronunciation Assessment + TTS + Listening)
# https://portal.azure.com → создать Speech resource (F0 — бесплатный tier 5 часов/мес)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Cron secret — для /api/cron/cleanup (произвольная строка, хранить в Coolify env)
CRON_SECRET=

# Sentry (опционально — observability)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
